# ── Feather Wing Tours — environment template (no real values) ──

# Session cookie signing (required in production)
SESSION_SECRET=

# Admin portal (/admin/login) — real username/password login, stored (scrypt-hashed)
# in the admin_users table. These two values only matter ONCE: they seed the
# first admin account the very first time the server starts with an empty
# database. After that, change the password from the portal itself (top bar →
# "Change password") — editing these vars later has no effect on an existing account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# AI (powers both the trip-planner assistant and the public concierge chat
# widget) — optional, a labeled development fallback runs without either key.
# Checked in this order: GEMINI_API_KEY first, then ANTHROPIC_API_KEY.
#
# Gemini has a free tier — get a key in ~30 seconds at
# https://aistudio.google.com/apikey (no credit card). Free-tier requests are
# rate-limited (resets daily) but otherwise fully functional, including the
# trip planner's tool-calling.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Anthropic — used only if GEMINI_API_KEY is unset. Paid; get a key at
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Maps Platform (optional — Leaflet/OSM map + labeled sample places run without it)
# Server key: Places API (New) + Routes API
GOOGLE_MAPS_SERVER_API_KEY=
# Browser key reserved for a future Google Maps JS adapter
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional live-data providers (labeled development data when unset)
WEATHER_API_KEY=
CURRENCY_API_KEY=

# Google Calendar (optional — meetings scheduled at /admin/meetings save to the
# local database only, unsynced, when unset). Uses a Service Account, not an
# OAuth login flow:
#   1. Google Cloud Console → create/select a project → enable the "Google Calendar API".
#   2. IAM & Admin → Service Accounts → create one → Keys → Add key (JSON) → download it.
#   3. In Google Calendar, share the target calendar with the service account's
#      client_email (grant "Make changes to events"), then copy that calendar's ID
#      (Calendar settings → Integrate calendar → Calendar ID).
#   4. Fill in the three values below from the downloaded JSON key + calendar ID.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Absolute origin used in invite links
NEXT_PUBLIC_APP_URL=http://localhost:3100

# SQLite data directory (defaults to ./data). On Railway, set this to your
# mounted volume's path (e.g. /data) — see DEPLOYMENT.md — otherwise every
# deploy/restart wipes the database, same problem serverless hosts have.
TP_DATA_DIR=
